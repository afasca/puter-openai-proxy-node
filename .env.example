# ---------------------------------------------------------------------------
# Proxy node configuration (example)
# Copy to `.env` and fill in real values. NEVER commit your real `.env`.
# ---------------------------------------------------------------------------

# The bearer key clients must send as `Authorization: Bearer <key>`.
# Recommended: store this in your Puter KV instead of source:
#   await puter.kv.set("proxy_api_key", "your-strong-secret-here");
PROXY_API_KEY=CHANGE_ME

# No upstream/third-party API key is required — calls go through Puter AI Cloud.
